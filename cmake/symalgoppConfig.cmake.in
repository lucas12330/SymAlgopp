@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Eigen fait partie de l'API publique (EquationDifferentielle::getMatriceCompagnon)
find_dependency(Eigen3 3.3 NO_MODULE)

# GMP n'est nécessaire à l'édition de liens que pour la version statique
if(NOT @BUILD_SHARED_LIBS@)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(GMP)
    list(REMOVE_AT CMAKE_MODULE_PATH 0)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/symalgoppTargets.cmake")

check_required_components(symalgopp)
